{
  "name": "criticseven",
  "version": "0.1.0",
  "description": "Movie Rating Application",
  "author": "Henry Cuffy",
  "license": "MIT",
  "private": false,
  "main": "./server.js",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm clean && pnpm transpile",
    "clean": "rimraf dist-server",
    "client": "pnpm --filter criticseven-client start",
    "debug:dev": "NODE_ENV=development DEBUG=criticseven:* pnpm build && pnpm server",
    "dev": "NODE_ENV=development pnpm build && pnpm server",
    "heroku-postbuild": "pnpm --filter criticseven-client build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter criticseven-client typecheck",
    "prod": "NODE_ENV=production pnpm build && pnpm server",
    "server": "node ./dist-server/index",
    "start": "pnpm prod",
    "start:dev": "concurrently \"pnpm dev\" \"pnpm client\"",
    "start:prod": "concurrently \"pnpm prod\" \"pnpm client\"",
    "test": "jest -i",
    "transpile": "babel ./server --out-dir dist-server --extensions '.js,.ts'",
    "watch:dev": "nodemon"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "axios": "1.20.0",
    "concurrently": "5.1.0",
    "cookie-parser": "1.4.7",
    "debug": "4.4.3",
    "dotenv": "8.2.0",
    "express": "4.22.2",
    "lodash": "4.18.1",
    "mongoose": "8.24.1",
    "morgan": "1.12.1"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/node": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.0",
    "babel-jest": "30.4.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "@types/supertest": "7.2.0",
    "jest": "30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "3.1.14",
    "prettier": "2.0.2",
    "rimraf": "3.0.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "nodemonConfig": {
    "exec": "pnpm dev",
    "watch": [
      "server/*"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "morgan@<1.12.1": "1.12.1",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "qs@>=2.2.5 <6.16.0": "6.16.0",
      "browserslist@<=4.28.6": "4.28.7",
      "body-parser@<1.20.6": "1.20.6",
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "compression@<1.8.2": "1.8.2",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "follow-redirects@<1.16.1": "1.16.1"
    }
  }
}
